{
  "name": "dsh-ui-outline",
  "version": "0.0.3",
  "description": "Turn navigation rail for dsh web following the official TurnNavigator design · 轮次导航轨道（大纲/刻度/毛玻璃预览）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iluluyu/dsh-ui-outline.git"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1.0.0",
    "react": ">=18.0.0"
  },
  "keywords": [
    "backdrop-filter",
    "chat-history",
    "conversation",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "glassmorphism",
    "navigator",
    "outline",
    "rail",
    "scroll",
    "sidebar",
    "thread-navigation",
    "turn-navigation",
    "会话",
    "侧边栏",
    "大纲",
    "对话导航",
    "对话记录",
    "导航条",
    "毛玻璃",
    "液态玻璃",
    "目录",
    "轮次导航"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
